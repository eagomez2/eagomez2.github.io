---
// Small icons for publication links, chosen by the link label.
interface Props { label: string }
const k = Astro.props.label.toLowerCase();
const icon =
  k.includes('download') ? 'download' :
  k.includes('demo') ? 'play' :
  k.includes('code') ? 'code' :
  k.includes('view') ? 'book' : 'external';
const paths: Record<string, string> = {
  download: 'M12 4v11M7 10l5 5 5-5M5 19h14',
  play: 'M8 5.5v13l11-6.5z',
  code: 'M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5M13.5 5l-3 14',
  book: 'M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5zM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5z',
  external: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
};
---
<svg class="link-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[icon]} /></svg>
