---
// Project list: a numbered index (like a record's track list). Each row is a link;
// on laptop a large cover beside the list follows the row under the mouse.
import { getProjects, projectUrl } from '../lib/data';
interface Props { category: 'software' | 'sound'; title: string }
const { category, title } = Astro.props;
const items = (await getProjects(category)).map((p) => ({ id: p.id, title: p.data.title, subtitle: p.data.subtitle, cover: p.data.cover, tags: p.data.tags, href: projectUrl(p) }));
---
<section class="section" style="gap: 24px">
  <div class="sec-head"><h1>{title}</h1></div>
  <div class="gc-wrap">
    <ol class="gc-list" aria-label={title}>
      {items.map((it, i) => (
        <li><a class="gc-row" href={it.href} data-img={it.cover} data-title={it.title} data-sub={it.subtitle}>
          <span class="gc-num mono">{String(i + 1).padStart(2, '0')}</span>
          <img class="gc-thumb" src={it.cover} alt="" width="72" height="72">
          <span class="gc-text"><span class="gc-title">{it.title}</span><span class="gc-sub">{it.subtitle}</span>
            {it.tags.length > 0 && <span class="gc-tags">{it.tags.map((t) => <span class="tag">{t}</span>)}</span>}</span>
          <span class="gc-go" aria-hidden="true">→</span>
        </a></li>
      ))}
    </ol>
    <div class="gc-preview" aria-hidden="true"><img src={items[0].cover} alt="" width="420" height="420" data-gc-img>
      <div class="gc-cap"><span class="gc-title" data-gc-title>{items[0].title}</span><span class="gc-sub" data-gc-sub>{items[0].subtitle}</span></div></div>
  </div>
  <slot />
</section>
<style is:global>
  .gc-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; align-items: start; }
  .gc-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .gc-row { display: grid; grid-template-columns: 32px 72px minmax(0, 1fr) 20px; gap: 18px; align-items: center; padding: 14px 8px; border-bottom: 1px solid var(--line); color: var(--fg); text-decoration: none; border-radius: 6px; transition: background .12s; }
  .gc-row:hover, .gc-row:focus-visible { background: var(--side); }
  .gc-num { font-size: 13px; color: var(--muted); }
  .gc-thumb { width: 72px; height: 72px; object-fit: cover; border-radius: 6px; display: block; background: var(--code); }
  .gc-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .gc-title { font-weight: 600; }
  .gc-text { gap: 3px; }
  .gc-title { font-size: 17px; }
  .gc-sub { font-size: 15px; color: var(--muted); }
  .gc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 5px; }
  .gc-tags .tag { font-size: 12.5px; padding: 1px 9px; color: var(--muted); }
  .gc-cap { display: flex; flex-direction: column; gap: 2px; margin-top: 14px; }
  .gc-go { color: var(--muted); transition: transform .15s, color .15s; }
  .gc-row:hover .gc-go { color: var(--accent); transform: translateX(3px); }
  .gc-preview { position: sticky; top: 32px; }
  .gc-preview img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 12px; display: block; box-shadow: 0 12px 30px var(--shadow); background: var(--code); }
  @media (max-width: 1100px) { .gc-wrap { grid-template-columns: minmax(0, 1fr); } .gc-preview { display: none; } }
  @media (max-width: 720px) { .gc-row { grid-template-columns: 56px minmax(0, 1fr) 16px; gap: 12px; padding: 8px 4px; } .gc-num { display: none; } .gc-thumb { width: 56px; height: 56px; } .gc-row { align-items: start; } }
</style>
<script>
  const img = document.querySelector<HTMLImageElement>('[data-gc-img]');
  const ct = document.querySelector<HTMLElement>('[data-gc-title]');
  const cs = document.querySelector<HTMLElement>('[data-gc-sub]');
  document.querySelectorAll<HTMLAnchorElement>('.gc-row').forEach((r) => {
    const show = () => { if (img) img.src = r.dataset.img!; if (ct) ct.textContent = r.dataset.title!; if (cs) cs.textContent = r.dataset.sub!; };
    r.addEventListener('mouseenter', show); r.addEventListener('focus', show);
  });
</script>
