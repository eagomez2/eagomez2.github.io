---
import { getProjects, projectUrl } from '../lib/data';
interface Props { category: 'software' | 'sound'; title: string }
const { category, title } = Astro.props;
const items = (await getProjects(category)).map((p) => ({
  id: p.id, title: p.data.title, subtitle: p.data.subtitle, cover: p.data.cover, href: projectUrl(p),
}));
const first = items[0];
---
<section class="section" style="gap: 24px">
  <div class="sec-head"><h1>{title}</h1></div>
  <div class="featured" aria-live="polite" data-gallery-featured>
    <img src={first.cover} alt={`Cover of ${first.title}`} width="280" height="280" data-f="img">
    <div class="featured-info">
      <div class="featured-pos mono" data-f="pos">1 / {items.length}</div>
      <h2 class="featured-title" data-f="title">{first.title}</h2>
      <div class="featured-sub" data-f="sub">{first.subtitle}</div>
      <div class="featured-actions">
        <a class="btn-primary" href={first.href} data-f="href">Open project</a>
        <button type="button" class="round-btn" data-step="-1" aria-label="Previous project"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
        <button type="button" class="round-btn" data-step="1" aria-label="Next project"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
      </div>
    </div>
  </div>
  <ul class="covers" aria-label={title}>
    {items.map((it, i) => (
      <li>
        <a class="cover" href={it.href} aria-pressed={i === 0 ? 'true' : 'false'} data-i={i} data-id={it.id} data-title={it.title} data-sub={it.subtitle} data-img={it.cover}>
          <img src={it.cover} alt="" width="160" height="160" loading={i < 12 ? 'eager' : 'lazy'}>
          <span class="cover-text"><span class="cover-title">{it.title}</span><span class="cover-sub">{it.subtitle}</span></span>
        </a>
      </li>
    ))}
  </ul>
  <slot />
</section>

<script>
  // Covers are plain links (they work without JavaScript). With JavaScript, a click
  // shows the project in the panel above; the "Open project" button opens its page.
  const panel = document.querySelector<HTMLElement>('[data-gallery-featured]');
  const covers = Array.from(document.querySelectorAll<HTMLAnchorElement>('.cover'));
  if (panel && covers.length) {
    const f = (k: string) => panel.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
    let cur = 0;
    const show = (i: number, focus = false) => {
      cur = (i + covers.length) % covers.length;
      const c = covers[cur];
      covers.forEach((x, j) => x.setAttribute('aria-pressed', String(j === cur)));
      const img = f('img') as HTMLImageElement;
      img.src = c.dataset.img!; img.alt = `Cover of ${c.dataset.title}`;
      f('pos').textContent = `${cur + 1} / ${covers.length}`;
      f('title').textContent = c.dataset.title!;
      f('sub').textContent = c.dataset.sub!;
      (f('href') as HTMLAnchorElement).href = c.href;
      history.replaceState(null, '', `#${c.dataset.id}`);
      if (focus && matchMedia('(max-width: 720px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    covers.forEach((c, i) => c.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      show(i, true);
    }));
    panel.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(cur + Number(b.dataset.step))));
    const start = covers.findIndex((c) => `#${c.dataset.id}` === location.hash);
    if (start > 0) show(start);
  }
</script>
