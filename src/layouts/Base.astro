---
import '@fontsource/source-sans-3/300.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/400-italic.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource/source-code-pro/400.css';
import '@fontsource/source-code-pro/500.css';
import '../styles/global.css';
import { site } from '../lib/data';
import ThemeToggle from '../components/ThemeToggle.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Analytics from '../components/Analytics.astro';
import font400 from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import font600 from '@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url';

interface Props { title?: string; description?: string; current?: string; image?: string; jsonLd?: Record<string, unknown> }
const { title, description = `${site.name}, ${site.tagline}. Research, software and music.`, current = '', image = '/images/profile.jpg', jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Audio Researcher & Programmer`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const nav = [
  { id: 'about', href: '/', label: 'About me', sub: 'Who am I and what I do' },
  { id: 'research', href: '/research/', label: 'Research & Talks', sub: 'Academic & Industry' },
  { id: 'software', href: '/portfolio-software-hardware/', label: 'Software & Hardware', sub: 'Software & hardware projects' },
  { id: 'sound', href: '/portfolio-sound-music/', label: 'Sound & Music', sub: 'Music & sound engineering' },
  { id: 'resume', href: site.resume, label: 'Resume', sub: 'Download my resume', external: true },
  { id: 'contact', href: '/contact/', label: 'Contact', sub: 'Get in touch' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.png" type="image/png">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL(image, Astro.site).href}>
  <meta property="og:site_name" content={site.name}>
  <meta name="twitter:card" content="summary">
  <meta name="author" content={site.name}>
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={font600} as="font" type="font/woff2" crossorigin>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <meta name="color-scheme" content="light">
  <script is:inline>
    // Apply the saved theme before the page paints, so there is no flash.
    try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <Analytics />
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <div class="shell">
    <aside class="sidebar">
     <div class="sidebar-inner">
      <div class="brand-wrap">
        <a class="brand" href="/">
          <span class="wordmark"><span class="w-bold">esteban</span><span class="w-light">gómez</span></span>
          <span class="tagline">{site.tagline}</span>
        </a>
      </div>
      <nav aria-label="Main" class="nav">
        {nav.map((n) => (
          <a href={n.href} class="nav-item" aria-current={n.id === current ? 'page' : undefined} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}>
            <span class="nav-label">{n.label}{n.external && <span class="nav-pdf"> PDF ↗</span>}</span>
            <span class="nav-sub">{n.sub}</span>
          </a>
        ))}
      </nav>
      <div class="side-foot">
        <div class="side-social">
          {site.social.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><SocialIcon name={s.label} /></a>)}
        </div>
        <ThemeToggle />
      </div>
     </div>
    </aside>

    <header class="topbar">
      <div class="topbar-row">
        <a class="brand" href="/">
          <span class="wordmark"><span class="w-bold">esteban</span><span class="w-light">gómez</span></span>
          <span class="tagline">{site.tagline}</span>
        </a>
        <div class="topbar-actions">
          <ThemeToggle />
          <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            <span>Menu</span>
          </button>
        </div>
      </div>
      <nav aria-label="Main" class="mobile-nav" id="mobile-nav" hidden>
        {nav.map((n) => (
          <a href={n.href} class="nav-item" aria-current={n.id === current ? 'page' : undefined} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}>
            <span class="nav-label">{n.label}{n.external && <span class="nav-pdf"> PDF ↗</span>}</span>
            <span class="nav-sub">{n.sub}</span>
          </a>
        ))}
      </nav>
    </header>

    <div class="page">
      <main id="content" class="main">
        <slot />
      </main>
      <footer class="footer">
        <span>{site.copyright}</span>
        <span class="footer-links">
          {site.social.map((s) => <a href={s.href} target="_blank" rel="noopener"><SocialIcon name={s.label} size={15} /><span>{s.label}</span></a>)}
        </span>
      </footer>
    </div>
  </div>
  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const menu = document.getElementById('mobile-nav');
    btn?.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      if (menu) menu.hidden = !open;
    });
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => {
      b.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.dataset.theme === 'dark';
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    });
  </script>
</body>
</html>
